            "type": "string",
            "title": "The total basis points associated with all commissions on this order"
          },
          "participateDontInitiate": {
            "type": "boolean",
            "title": "Set if immediate match is not desired"
          },
          "cashOrderQty": {
            "type": "string",
            "format": "int64",
