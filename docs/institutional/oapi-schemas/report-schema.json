            "type": "string",
            "format": "int64",
            "description": "The price scale of the order, copied from the instrument at order creation time.\nUse this to convert raw integer prices to decimal (e.g., price / 10^price_scale)."
          },
          "fractionalQuantityScale": {
            "type": "string",
            "format": "int64",
            "description": "The fractional quantity scale of the order, copied from the instrument at order creation time.\nUse this to convert raw integer quantities to decimal (e.g., qty / 10^fractional_quantity_scale)."
          },
          "priceToQuantityFilled": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "int64"
            },
            "description": "Denotes the quantity filled at each price point over the life of the order.\nKey is the price, value is the quantity filled at that price."
